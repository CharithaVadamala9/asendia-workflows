# Copy to backend/.env and fill in. .env is gitignored — never commit real credentials.
#   cp backend/.env.example backend/.env

# --- JobDiva ATS -------------------------------------------------------------
# Set to "live" once the credentials below are verified. "mock" runs off fixtures.
JOBDIVA_MODE=mock
# Integer, provided by JobDiva.
JOBDIVA_CLIENT_ID=
# Account username (an email address).
JOBDIVA_USERNAME=
JOBDIVA_PASSWORD=
# JobDiva user id that authored notes/screeners we write back. Optional.
JOBDIVA_RECRUITER_ID=

# Separate from JOBDIVA_MODE, and separate on purpose. Reads can be live — real jobs,
# applicants, resumes — while writes are captured and shown instead of sent. Creating a
# submittal puts a record in a real recruiter's work queue, so mutation is opt-in.
#   suppressed = record the payload, send nothing (default)
#   live       = actually write to JobDiva
JOBDIVA_WRITE_MODE=suppressed

# --- VAPI (AI voice interview) -----------------------------------------------
VAPI_MODE=mock
# Private key, server-side only. A UUID from the Vapi dashboard.
VAPI_API_KEY=
# From: POST https://api.vapi.ai/phone-number after importing a Twilio number.
# VAPI's own free numbers CANNOT place outbound calls.
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=change-me-to-a-random-string

# VAPI posts call results here, so during local dev this must be a public tunnel
# (ngrok/cloudflared), not localhost.
PUBLIC_BASE_URL=http://localhost:8000

# --- Twilio ------------------------------------------------------------------
# Needed to buy the number VAPI dials out from. A Twilio *trial* account can only
# call verified numbers — upgrade if you need to dial arbitrary candidates.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Mailjet (email) ---------------------------------------------------------
MAILJET_MODE=mock
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Must be a sender you have already verified with Mailjet, or sends fail.
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Asendia Recruiting

# --- SMS ---------------------------------------------------------------------
# log    = record the exact message, send nothing (demo default)
# mailjet= requires a funded SMS wallet + a 48h security check after first deposit
# twilio = works immediately if the Twilio credentials above are set
SMS_MODE=log
# Separate from MAILJET_API_KEY - generated in the Mailjet SMS dashboard.
MAILJET_SMS_TOKEN=
MAILJET_SMS_FROM=Asendia

# --- LLM (resume scoring + interview question generation) --------------------
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Execute every step and record what would have been sent, without sending it.
DRY_RUN=false
